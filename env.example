VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Required for npm run db:push and npm run db:link
# Supabase Dashboard → Project Settings → Database → Database password
# Use quotes if the password contains #, spaces, or other special characters.
SUPABASE_DB_PASSWORD="your-database-password"

# Session pooler host (IPv4-compatible). Dashboard → Connect → Session pooler.
SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com

# Password reset emails (Supabase Edge Function secrets — not used by the Vite app)
# Set with: supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM_EMAIL="A-DNA <noreply@yourdomain.com>" SITE_URL=https://your-site.com
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL="A-DNA <noreply@yourdomain.com>"
# SITE_URL=https://your-site.com
