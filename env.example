# Copy to .env: cp env.example .env

# --- Frontend (Vite) — required to run the app ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional — Zeffy membership checkout (opens in new tab from member portal)
# VITE_ZEFFY_MEMBERSHIP_URL=https://www.zeffy.com/en-US/ticketing/ghanaian-diaspora-nursing-alliances-memberships-2
# Optional tier-specific checkout URLs (fallback to VITE_ZEFFY_MEMBERSHIP_URL):
# VITE_ZEFFY_MEMBERSHIP_URL_PROFESSIONAL=https://www.zeffy.com/en-US/ticketing/...
# VITE_ZEFFY_MEMBERSHIP_URL_PREMIUM=https://www.zeffy.com/en-US/ticketing/...
# Checkout URLs prefill email, first name, and last name from registration or the member profile.
# Ask Zeffy support to redirect buyers after payment to:
#   https://your-site.com/membership/confirmation

# --- Supabase CLI (migrations) — required for npm run db:push / db:link ---
# Dashboard → Project Settings → Database → Database password
# Use quotes if the password contains #, spaces, or other special characters.
SUPABASE_DB_PASSWORD="your-database-password"

# Dashboard → Connect → Session pooler (IPv4-compatible)
SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com

# --- GitHub Actions (deploy workflow) — optional in .env for npm run secrets:github ---
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=team_or_user_id
# VERCEL_PROJECT_ID=prj_xxxxxxxx

# --- Email (Resend via Supabase Edge Functions — NOT stored in .env) ---
# Set as Supabase secrets, then run: npm run secrets:set && npm run functions:deploy
#
#   supabase secrets set \
#     RESEND_API_KEY=re_your_key \
#     RESEND_FROM_EMAIL="A-DNA <noreply@yourdomain.com>" \
#     SITE_URL=https://your-site.com \
#     INTERNAL_FUNCTION_SECRET=your-long-random-secret
#
# SITE_URL is used in registration emails (logo, links). Use your public site URL.
#   Production (main):  https://a-dna.org
#   Preview (develop):  https://preview.a-dna.org
# Functions: password-reset-request, membership-registration-email, zeffy-membership-webhook,
#   zeffy-membership-sync, member-welcome-email-reconcile
#
# Shared secret for internal-only edge functions (membership-registration-email):
# INTERNAL_FUNCTION_SECRET=your-long-random-secret
#
# Local-only fallbacks (never set in production):
# ALLOW_LOCAL_SITE_URL=true
# ALLOW_INSECURE_WEBHOOK_DEV=true

# --- Zeffy membership payments (Supabase Edge Function webhook) ---
# After deploy, paste this URL in Zeffy → Settings → Integrations → Webhook:
#   https://<project-ref>.supabase.co/functions/v1/zeffy-membership-webhook
#
# Optional but recommended — same value as a custom header or Bearer token on webhook requests:
# ZEFFY_WEBHOOK_SECRET=your-long-random-secret
#
# Optional — map Zeffy campaign IDs to tiers (comma-separated UUIDs from Zeffy API/campaign URLs):
# ZEFFY_CAMPAIGN_PROFESSIONAL=campaign-uuid-for-75-usd-or-300-ghs
# ZEFFY_CAMPAIGN_PREMIUM=campaign-uuid-for-150-usd-or-600-ghs
#
# If campaign IDs are omitted, tier is inferred from payment amount:
#   Professional (diaspora): $75 USD (7500 cents) / 300 GHS (30000 pesewas)
#   Premium:                 $150 USD (15000 cents) / 600 GHS (60000 pesewas)
#
# Optional rate_id fallbacks (comma-separated) from Zeffy ticket types.
# A-DNA uses the same rate_id for Professional and Premium — set both vars to the same UUID.
# Tier is resolved from payment amount ($75 / $150 USD or 300 / 600 GHS), not rate_id.
# ZEFFY_RATE_PROFESSIONAL=0f769222-6e47-4cdf-b38e-3919c78004ca
# ZEFFY_RATE_PREMIUM=0f769222-6e47-4cdf-b38e-3919c78004ca
#
# Optional — Zeffy API key for portal "Refresh status" backfill when webhook missed a payment.
# Set as Supabase secret (ZEFFY_API_KEY) via npm run secrets:set — never expose in Vite/browser.
# ZEFFY_API_KEY=your-zeffy-api-key
#
# Member must already exist (registered via the site) with the same email as the Zeffy payer.
# Buyer first/last name from the webhook is written to member_dues and synced onto members.
#
# --- Admin only: manual payment replay (if webhook missed a Zeffy payment) ---
# Add to .env locally — NEVER commit or expose in Vite/browser:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# CLI (after verifying Zeffy receipt):
#   npm run zeffy:apply-payment -- user@example.com diaspora
#   npm run zeffy:apply-payment -- user@example.com premium --payment-id zeffy_abc123
#
# Or run scripts/sql/apply-manual-payment.example.sql in Supabase Dashboard → SQL Editor.
#
# --- Welcome email reconciliation cron (hourly safety net) ---
# Primary path: Zeffy webhook sends welcome email immediately after payment.
# Backup path: member-welcome-email-reconcile Edge Function runs hourly via pg_cron.
#
# After deploy, store vault secrets once in Supabase Dashboard → SQL Editor:
#   select vault.create_secret('https://<project-ref>.supabase.co', 'supabase_project_url', 'Project URL for cron');
#   select vault.create_secret('<INTERNAL_FUNCTION_SECRET>', 'internal_function_secret', 'Cron auth for edge functions');
#
# Manual invoke (uses same INTERNAL_FUNCTION_SECRET as membership-registration-email):
#   curl -X POST "https://<project-ref>.supabase.co/functions/v1/member-welcome-email-reconcile" \
#     -H "Content-Type: application/json" \
#     -H "x-internal-function-secret: $INTERNAL_FUNCTION_SECRET" \
#     -d '{"source":"manual","p_limit":50}'
#
# Faster recovery: change cron schedule in migration to */15 * * * * (every 15 minutes).

# --- Demo member portal account (after npm run db:push) ---
# Email:    demo@adna.org
# Password: DemoPassword123!
